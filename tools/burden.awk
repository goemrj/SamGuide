# 「총진료비,본인부담금 계산식.xlsx」의 본인부담률 시트(TSV) → JSON
# 원문을 해석하지 않고 글자 그대로 옮긴다 — 해석은 화면(계산기)에서 따로 한다.
#
# ── 시트 모양이 한 가지가 아니다 ────────────────────────────────────────
# 대부분은  A=구분(대분류) B=항목 C=내용 D~=비고  4단이고, 구분은 블록 첫 줄에만
# 적혀 있고 아래로 이어진다(엑셀 병합 관례).
#   상급종합병원 | 일반환자        | 진찰료총액 + 나머지 60%
#                | 임신부 (F015)   | 총진료비 40%
# 그런데 같은 파일 안에서 구분 없이 A=항목 B=내용 2단으로 적힌 블록도 섞여 있다.
#   일반환자        | 총진료비 20% | 식대총액 50%
#   15세 이하(F018) | 총진료비 5%
# 이걸 구분해내지 못하면 부담률이 "항목" 칸에 들어가 화면이 뒤집힌다.
#
# A가 채워진 줄에서 그 A가 구분인지 항목인지를 아래 순서로 판정한다.
#   1) C·비고가 비어 있으면          → 두 칸짜리 줄이므로 A는 항목
#   2) 바로 다음 줄의 A가 비어 있으면 → A는 아래 줄들을 거느리는 구분(병합)
#   3) B가 이미 부담률처럼 생겼으면   → A는 항목 (B가 항목일 리 없다)
#   4) 그 밖에는                     → 한 줄짜리 구분
# 다음 줄을 봐야 하므로 파일을 두 번 읽는다 — 1차에서 모아 두고 2차에서 판정한다.
# 어느 쪽으로 판정되든 글자는 하나도 버리지 않는다(항목·내용·비고로 그대로 옮겨간다).
# ──────────────────────────────────────────────────────────────────────

# "부담률처럼 생긴" 문자열 — 퍼센트·금액·면제 같은 산정 표현이 들어 있는 경우
BEGIN { RULEISH = "%|원|면제|무료|정액|본부|총진료비|해당비용|0\\.[0-9]" }

function trim(s){ gsub(/^[ \t]+/,"",s); gsub(/[ \t]+$/,"",s); return s }
function jesc(s){ gsub(/\\/,"\\\\",s); gsub(/"/,"\\\"",s); gsub(/\r/,"",s); return s }

BEGIN { FS="\t"; first=1 }

# ---------- 1차: 줄을 그대로 모아 둔다 (첫 줄은 시트 제목이라 건너뛴다) ----------
NR == FNR {
  if (FNR == 1) next
  A[++m] = trim($1); B[m] = trim($2); C[m] = trim($3)
  t = ""
  for (i = 4; i <= NF; i++){ u = trim($i); if (u != "") t = (t == "" ? u : t " " u) }
  N[m] = t
  next
}

# ---------- 2차: 판정해서 출력 ----------
FNR == 1 {
  for (k = 1; k <= m; k++){
    a = A[k]; b = B[k]; c = C[k]; n = N[k]
    if (a == "" && b == "" && c == "" && n == "") continue

    # 차상위부터는 별도 표로 나눈다(시트 안에서 자격이 완전히 바뀌는 지점)
    if (a ~ /^차상위$/ && b == "" && c == ""){ printf "\n@@SPLIT@@\n"; group = ""; first = 1; continue }

    if (b == "" && c == "" && n == ""){            # A만 있는 줄 = 시트 아래쪽 각주
      printf "%s{\"note\":\"%s\"}", (first ? "" : ",\n"), jesc(a); first = 0; continue
    }

    if (a != ""){
      # 다음(내용이 있는) 줄
      nx = 0
      for (j = k + 1; j <= m; j++){ if (A[j] != "" || B[j] != "" || C[j] != "" || N[j] != ""){ nx = j; break } }

      if (c == "" && n == "")            isItem = 1   # 두 칸짜리 줄 (A=항목, B=내용)
      else if (nx && A[nx] == "")        isItem = 0   # 아래 줄들을 거느리는 구분
      else if (b ~ RULEISH)              isItem = 1   # B가 이미 부담률이면 A는 항목이다
      else                               isItem = 0   # 한 줄짜리 구분

      if (isItem){ n = (c == "" ? n : (n == "" ? c : c " " n)); c = b; b = a }   # 한 칸씩 당긴다
      else group = a
    }

    printf "%s{\"g\":\"%s\",\"i\":\"%s\",\"r\":\"%s\",\"n\":\"%s\"}",
      (first ? "" : ",\n"), jesc(group), jesc(b), jesc(c), jesc(n)
    first = 0
  }
  print ""
  exit
}
