BEGIN{ rows = 0; tbl = 0; DQ = sprintf("%c", 34);BS = sprintf("%c", 92); CR = sprintf("%c", 13); FF = sprintf("%c", 12) }

# pdftotext 는 윈도우에서 줄끝에 CR 을, 쪽 끝에 FF(쪽 나눔)를 붙인다.
# 남겨 두면 칸 값 끝에 딸려 들어간다.
{ gsub(CR, ""); gsub(FF, "") }

# 쪽 머리글 · 쪽번호 · 열 머리줄 · 빈 줄은 버린다
/제1편.*상대가치점수/    { next }
/제2부.*응급의료수가/    { next }
/^[ \t]*[0-9]{3}[ \t]*$/ { next }
/분류번호/               { next }
/^[ \t]*$/               { next }

# (별표 N) 제목 — "(별표  1)      해당 분류항목"
/\(별표[ \t]*[0-9]+\)/ {
  line = squeeze(trim($0))
  p    = index(line, ")")
  num  = substr(line, 1, p); gsub(/[^0-9]/, "", num)
  tbl  = num + 0
  TITLE[tbl] = trim(substr(line, p + 1))
  next
}

{
  line = squeeze(trim($0))

  if (tbl <= 3) {
    # 장(2자리) · 분류번호 · 코드(영문 1자 + 영숫자 4자) · 분류
    if (match(line, /^[0-9][0-9] [^ ]+ [A-Z][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9] /)) {
      split(line, f, " ")
      rows++
      tb[rows]   = tbl
      ch[rows]   = f[1]
      no[rows]   = f[2]
      code[rows] = f[3]
      name[rows] = trim(substr(line, length(f[1] " " f[2] " " f[3] " ") + 1))
      next
    }
    addcont(line); next
  }

  # (별표 4) — 분류번호(자29가주 처럼 한글 + 숫자로 시작) · 행위명(한글)
  if (match(line, /^[가-힣][0-9][^ ]* /)) {
    rows++
    tb[rows]   = tbl
    ch[rows]   = ""
    code[rows] = ""
    no[rows]   = substr(line, 1, RLENGTH - 1)
    name[rows] = trim(substr(line, RLENGTH))
    next
  }
  addcont(line)
}

END{
  # ---- (별표 4)의 장 · 코드 채우기 ----
  # 1) 같은 문서의 (별표 1)~(별표 3)에 같은 분류번호가 있으면 그 장 · 코드를 가져온다.
  #    분류번호 하나에 코드가 둘 이상 붙는 경우는 없었다(있으면 아래에서 알려 준다).
  for (i = 1; i <= rows; i++) if (tb[i] != 4 && no[i] != "") {
    if ((no[i] in T3C) && T3C[no[i]] != code[i]) DUP[no[i]] = DUP[no[i]] " " code[i]
    T3C[no[i]] = code[i]; T3H[no[i]] = ch[i]
  }
  # 분류번호 하나에 코드가 둘 이상 붙은 것(자190 · 자587주 등 8건)은 어느 것인지 고를 수
  # 없으므로 채우지 않는다. 지금은 (별표 4)에 그런 분류번호가 하나도 없다.
  for (k in DUP) delete T3C[k]

  for (i = 1; i <= rows; i++) {
    if (tb[i] != 4 || code[i] != "") continue
    if (no[i] in T3C) {
      ch[i] = T3H[no[i]]; code[i] = T3C[no[i]]; fill[i] = "t3"; f3++
    } else if (no[i] in X) {
      ch[i] = "09"; code[i] = X[no[i]]; fill[i] = "p" XP[no[i]]; f9++
    } else {
      print "### (별표 4) 장·코드를 못 찾았다: " no[i] "  " name[i] > "/dev/stderr"; fx++
    }
  }

  print "/* ---------- 응급의료행위 별표 (자동 생성 — 손으로 고치지 말 것) ----------"
  print "   출처: 「건강보험 행위 급여･비급여 목록표 및 급여 상대가치점수」(수가책)"
  print "         제1편 제2부 제19장 응급의료수가 — 제2절 응급의료행위 ·"
  print "         제3절 권역외상센터 응급의료행위의 (별표 1) ~ (별표 4). 수가책 709~763쪽."
  print "   (별표 1)(별표 2)(별표 3) 은 장 · 분류번호 · 코드 · 분류 4열,"
  print "   (별표 4) 는 분류번호 · 행위명(한글) 2열이라 원문에 장 · 코드가 없다."
  print "   그 장 · 코드는 같은 수가책 안에서 분류번호로 찾아 채웠고, 어디서 찾았는지를"
  print "   (별표 4) 행의 f 에 적어 둔다 — \"t3\" = (별표 1)~(별표 3), \"p<쪽>\" = 제9장 본문 <쪽>쪽."
  print "   칸 안에서 접힌 줄을 붙이는 규칙은 tools/emergency.awk 머리글에 적어 두었다."
  print "   변환: tools/emergency.awk ---------- */"
  print "const EMG_TABLES = ["
  for (t = 1; t <= 4; t++) {
    cnt = 0
    for (i = 1; i <= rows; i++) if (tb[i] == t) cnt++
    printf "{\"no\":%d,\"title\":\"%s\",\"n\":%d},\n", t, jesc(TITLE[t]), cnt
  }
  print "];"
  print "/* 장 이름은 수가책 목차(제1편 제2부)의 장 제목 그대로다 — 별표 원문에는 장 번호만 있다 */"
  print "const EMG_CHAPTERS = {"
  for (i = 1; i <= rows; i++) if (ch[i] != "") SEEN[ch[i]] = 1
  n = asorti(SEEN, ORD)
  for (k = 1; k <= n; k++) {
    c = ORD[k]
    if (!(c in CHAP)) print "### 모르는 장 번호: " c > "/dev/stderr"
    printf "\"%s\":\"%s\",\n", c, jesc(CHAP[c])
  }
  print "};"
  print "const EMG_CODES = ["
  for (i = 1; i <= rows; i++)
    printf "{\"t\":%d,\"ch\":\"%s\",\"no\":\"%s\",\"code\":\"%s\",\"name\":\"%s\"%s},\n",
           tb[i], ch[i], jesc(no[i]), code[i], jesc(name[i]),
           (fill[i] == "" ? "" : ",\"f\":\"" fill[i] "\"")
  print "];"
  for (t = 1; t <= 4; t++) {
    cnt = 0
    for (i = 1; i <= rows; i++) if (tb[i] == t) cnt++
    print "별표 " t " (" TITLE[t] "): " cnt " 행" > "/dev/stderr"
  }
  print "모두 " rows " 행" > "/dev/stderr"
  print "(별표 4) 장·코드 채움 — (별표1~3)에서 " f3+0 " · 제9장 본문에서 " f9+0 " · 못 찾음 " fx+0 > "/dev/stderr"
}
