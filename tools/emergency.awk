# ---------- 응급의료행위 별표 (수가책 709~763쪽) → data/emergency-codes.js ----------
# 만드는 방법 (README 「응급의료행위 별표」 참조):
#   pdftotext -table -enc UTF-8 -f 722 -l 776 수가책.pdf emg.txt
#   LC_ALL=C.UTF-8 awk -f tools/emergency.awk emg.txt > data/emergency-codes.js
#
# 인쇄 쪽번호 = PDF 쪽번호 - 13 이라 709~763쪽은 PDF 722~776쪽이다.
# 여러 단으로 된 표라서 -layout 이 아니라 -table 로 뽑아야 칸이 안 섞인다(CLAUDE.md).
# LC_ALL=C.UTF-8 이 없으면 substr 이 한글을 바이트로 세어 칸이 어긋난다(CLAUDE.md).
#
# 표 모양
#   (별표 1)(별표 2)(별표 3)  장 · 분류번호 · 코드 · 분 류      4열
#   (별표 4)                 분류번호 · 행위명(한글)          2열
#
# (별표 4)의 장 · 코드는 원문에 없어서 **같은 수가책 안에서 분류번호로 찾아 채운다.**
# 채운 값에는 `f`(어디서 찾았는지)를 함께 넣는다 — 화면이 원문 값과 구분해 보여 준다.
#   f = "t3"  같은 문서의 (별표 1)~(별표 3)에 같은 분류번호가 있어 그 장·코드를 가져왔다
#   f = "p<쪽>"  (별표 1)~(별표 3)에 없어서 제9장 본문 상대가치점수표 <쪽>쪽에서 읽었다
#                (아래 X[] · XP[] — 41건. 목록과 근거 쪽은 README 에도 적어 두었다)
# (별표 4)는 전부 자___(제9장 처치 및 수술료 등)여서 장은 09 하나뿐이다.
#
# 줄바꿈 붙이기 — PDF 는 칸 안에서 접힌 자리에 띄어쓰기가 있었는지 알려주지 않는다.
# 그래서 아래 규칙으로만 붙인다(추측으로 글자를 넣거나 빼지 않는다).
#   1) 양쪽정렬 때문에 늘어난 공백(2칸 이상)은 1칸으로 줄인다.
#   2) 접힌 자리는 붙여 쓴다 — 앞줄이 - – ( [ ･ / ~ ∼ 로 끝날 때,
#      뒷줄이 ) ] - – , ~ ∼ ･ 나 소문자 알파벳으로 시작할 때(낱말 중간에서 접힌 것),
#      그리고 앞줄에 띄어쓰기가 아예 없을 때(붙여 쓴 행위명).
#   3) 그 밖에는 1칸 띄운다.
#
# 원문에 " 와 역슬래시는 한 글자도 없다(확인함). 그래서 JSON 은 그대로 적고,
# 혹시 나오면 jesc() 가 stderr 로 알려 준다.
# ------------------------------------------------------------------------------

function trim(s){ gsub(/^[ \t]+|[ \t]+$/,"",s); return s }
function squeeze(s){ gsub(/[ \t][ \t]+/," ",s); return s }
function jesc(s){
  if (index(s, DQ) || index(s, BS)) print "### JSON 에 넣을 수 없는 글자가 있다: " s > "/dev/stderr"
  return s
}

# 앞줄(a) 과 뒷줄(b) 을 붙일 때 사이에 넣을 것
function glue(a,b,  last,first){
  last  = substr(a, length(a))
  first = substr(b, 1, 1)
  if (index("-–([･/~∼", last))  return ""
  if (index(")]-–,~∼･", first)) return ""
  if (first ~ /^[a-z]$/)        return ""
  if (a ~ /[0-9][A-Za-z]{0,2}$/) return ""   # 길이5.0cm / 2cm 처럼 숫자+단위에서 접힌 것
  if (a !~ / /)                 return ""
  return " "
}
function addcont(txt){
  if (rows == 0) { print "### 붙일 앞 행이 없다: " txt > "/dev/stderr"; return }
  name[rows] = name[rows] glue(name[rows], txt) txt
}

